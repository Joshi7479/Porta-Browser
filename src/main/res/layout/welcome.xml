<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/black"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:visibility="gone"
        android:textColor="@color/blue_A200"
        android:gravity="center"
        android:id="@+id/portaschriftzug"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:id="@+id/portalogo"
        android:src="@drawable/portalogoundschriftzug"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textSize="18sp"
        android:textColor="@color/blue_A200"
        android:text="@string/welcometitle"/>

    <TextView
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:text="@string/logohidehint"/>




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textAlignment="center"
            android:textSize="14sp"
            android:textColor="@color/blue_A200"
            android:text="@string/tabbarhintonwelcomescreen"/>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/newtab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#F00000"
            android:text="@string/plus"/>

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/urlbarhint"
            android:maxLines="1"
            android:imeOptions="actionGo"
            android:inputType="textUri" />

        <Button
            android:id="@+id/hide"
            android:layout_width="wrap_content"
            android:backgroundTint="#F00000"
            android:layout_height="wrap_content"
            android:text="@string/burgermenu"/>
    </LinearLayout>


    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:backgroundTint="#F00000"
        android:layout_height="4dp"
        android:visibility="gone" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textColor="@color/blue_A200"
                android:text="@string/welcomemessage" />


            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/blue_A200"
                android:textColor="#F00000"
                android:id="@+id/welcomecolor"
                android:text="@string/welcomecolor"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/newline"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/blue_A200"
                android:text="@string/startporta"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/newline"/>

            <com.google.android.material.slider.Slider
                android:layout_width="match_parent"
                app:thumbColor="#00F0F0"
                app:trackColor="#F00000"
                android:layout_height="wrap_content"
                android:id="@+id/startporta"
                app:labelBehavior="gone"
                android:valueFrom="0.0"
                android:value="0.0"
                android:valueTo="1.0"/>



        </LinearLayout>
    </LinearLayout>
</LinearLayout>
