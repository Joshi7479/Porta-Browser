<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:visibility="gone"
        android:gravity="center"
        android:id="@+id/portaschriftzug"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:id="@+id/portalogo"
        android:src="@drawable/portalogoundschriftzug"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:id="@+id/settingstitle"
        android:text="@string/settingstitle"
        android:textColor="#F00000"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/keyboard"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:backgroundTint="@color/blue_A200"
            android:text="@string/keyboard" />

        <EditText
            android:id="@+id/test"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="@string/searchenginehint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textColorHint="#888888" />

        <Button
            android:id="@+id/save"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:backgroundTint="@color/blue_A200"
            android:text="@string/saveunicode" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/reset"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/blue_A200"
            android:text="@string/resetsearxng" />

        <Button
            android:id="@+id/ddg"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/blue_A200"
            android:text="@string/setduckduckgo" />

        <Button
            android:id="@+id/color"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/blue_A200"
            android:layout_marginTop="24dp"
            android:text="@string/colortheme" />


        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rerunsetup"
            android:backgroundTint="@color/blue_A200"
            android:id="@+id/rerunsetup"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/urlwhere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:checked="false"
            app:thumbTint="#F00000"
            app:trackTint="@color/blue_A200"
            android:text="@string/urlpositionsethint"
            android:textColor="#F00000" />

    </LinearLayout>

    <Button
        android:id="@+id/close"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#00F0F0"
        android:text="@string/done" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sevennewlines"/>

    <TextView
        android:id="@+id/madebyme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:gravity="center"
        android:text="@string/madeybyme"
        android:textColor="@android:color/white" />

</LinearLayout>