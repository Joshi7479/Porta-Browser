<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/black"
    android:orientation="vertical">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textSize="18sp"
        android:text="Welcome to: PORTA-Browser"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textAlignment="center"
            android:textSize="14sp"
            android:text="Here will be the Tab-bar. To close a Tab, click and hold it. To create a new one, use the Button below!"/>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/newtab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"/>

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="URL or search"
            android:maxLines="1"
            android:imeOptions="actionGo"
            android:inputType="textUri" />

        <Button
            android:id="@+id/hide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"/>
    </LinearLayout>


    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="The other Button is for the Sidebar with a lot of useful tools. Like go a side further, reload, etc.\n\nNote: This Browser is under development! Like this side.\n\n\n\n\n\n\n" />

            <Button
                android:layout_width="wrap_content"
                android:id="@+id/ready"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="Start using Porta!" />
        </LinearLayout>

        <TableLayout
            android:id="@+id/tablerow"
            android:layout_width="90dp"
            android:layout_gravity="left"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:visibility="gone">

            <TableRow>
                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="←" />
            </TableRow>

            <TableRow>
                <Button
                    android:id="@+id/btnReload"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="⟳"  />
            </TableRow>

            <TableRow>
                <Button
                    android:id="@+id/btnForward"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="→" />
            </TableRow>

            <TableRow>
                <Button
                    android:id="@+id/home"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="⌂" />
            </TableRow>

            <TableRow>
                <Button
                    android:id="@+id/settings"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="⚙" />
            </TableRow>
        </TableLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:layout_weight="1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PORTA-Browser\nMade by Joshi7479"/>
    </LinearLayout>

</LinearLayout>
